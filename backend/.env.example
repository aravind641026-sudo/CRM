# ===================================================================
# CallingCRM Backend - Environment Configuration Template (.env.example)
# ===================================================================
# Duplicate this file as .env in the backend directory and update the placeholders.
# DO NOT commit .env containing real credentials to GitHub.

# -------------------------------------------------------------------
# Server Port (Render sets this automatically)
# -------------------------------------------------------------------
PORT=8080

# -------------------------------------------------------------------
# Database Configuration (PostgreSQL / Neon)
# -------------------------------------------------------------------
# Recommended: Full cloud connection URI
DATABASE_URL=YOUR_NEON_DATABASE_URL

# Optional: Individual database connection parameters
DATABASE_HOST=YOUR_NEON_HOST
DATABASE_PORT=5432
DATABASE_NAME=YOUR_NEON_DATABASE
DATABASE_USERNAME=YOUR_NEON_USERNAME
DATABASE_PASSWORD=YOUR_NEON_PASSWORD

# Standard PostgreSQL cloud aliases (Neon / Render)
PGHOST=YOUR_NEON_HOST
PGPORT=5432
PGDATABASE=YOUR_NEON_DATABASE
PGUSER=YOUR_NEON_USERNAME
PGPASSWORD=YOUR_NEON_PASSWORD

# -------------------------------------------------------------------
# Security & JWT Configuration
# -------------------------------------------------------------------
# Minimum 256-bit (32-character) secret key for JWT HMAC-SHA signing
JWT_SECRET=YOUR_JWT_SECRET
JWT_EXPIRATION_MS=86400000

# -------------------------------------------------------------------
# CORS Configuration (Allowed Origins)
# -------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081,http://10.97.41.211:8081,http://192.168.1.43:8081,http://localhost:19006,http://192.168.1.43:5173

# -------------------------------------------------------------------
# Google Sheets / Google Apps Script Integration
# -------------------------------------------------------------------
GOOGLE_SCRIPT_URL=YOUR_GOOGLE_APPS_SCRIPT_URL
GOOGLE_SCRIPT_SECRET=YOUR_GOOGLE_APPS_SCRIPT_SECRET
GOOGLE_APPS_SCRIPT_URL=YOUR_GOOGLE_APPS_SCRIPT_URL
GOOGLE_APPS_SCRIPT_SECRET=YOUR_GOOGLE_APPS_SCRIPT_SECRET
GOOGLE_SHEETS_BATCH_SIZE=1000
GOOGLE_SHEETS_CONNECT_TIMEOUT_MS=10000
GOOGLE_SHEETS_READ_TIMEOUT_MS=60000
GOOGLE_SHEETS_MAX_RETRIES=2

# -------------------------------------------------------------------
# Firebase Authentication Configuration
# -------------------------------------------------------------------
FIREBASE_PROJECT_ID=callingcrm-9c9fd
FIREBASE_WEB_API_KEY=YOUR_FIREBASE_WEB_API_KEY
# Path to service account file (e.g., /etc/secrets/firebase-service-account.json on Render)
FIREBASE_CREDENTIALS_FILE=
# Alternatively, supply the raw JSON string or base64 string directly
FIREBASE_CREDENTIALS_JSON=

# -------------------------------------------------------------------
# Call Tracking & Classification Thresholds (in seconds)
# -------------------------------------------------------------------
CALL_THRESHOLD_VERY_SHORT=30
CALL_THRESHOLD_SHORT=60

# -------------------------------------------------------------------
# JPA / Hibernate & Logging (Optional)
# -------------------------------------------------------------------
HIBERNATE_DDL_AUTO=update
HIBERNATE_SHOW_SQL=false
LOGGING_LEVEL_CRM=INFO
LOGGING_LEVEL_SECURITY=INFO
